#include <iostream>
#include <vector>
#include <iomanip>
#include<windows.h>
using namespace std;

int main() {
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);
    vector<int> seatsInRow = { 7, 5, 8, 6, 9, 10, 7, 6, 8, 5 };


    vector<vector<bool>> cinema;


    for (int i = 0; i < 10; i++) {
        cinema.push_back(vector<bool>(seatsInRow[i], false));
    }

    int choice;

    do {

        cout << "\nТекущая схема зала:\n";
        cout << "Ряд: ";

        for (int i = 0; i < 10; i++) {
            cout << setw(3) <<"" << i;
        }
        cout << endl;

        for (int i = 0; i < 10; i++) {
            cout << "Ряд " << i << ": ";

            for (int j = 0; j < cinema[i].size(); j++) {
                if (cinema[i][j])
                    cout << "[X]";
                else
                    cout << "[ ]";
            }

            cout << endl;
        }

        // Меню
        cout << "\nМеню:\n";
        cout << "[1] Забронировать место\n";
        cout << "[2] Посчитать свободные места\n";
        cout << "[3] Найти самый заполненный ряд\n";
        cout << "[4] Вернуть билет\n";
        cout << "[0] Выход\n";
        cout << "Выберите действие: ";
        cin >> choice;

        if (choice == 1) {
            int row, seat;

            cout << "Введите номер ряда (0-9): ";
            cin >> row;

            if (row < 0 || row >= 10) {
                cout << "Такого ряда нет!\n";
                continue;
            }

            cout << "Введите номер места (0-"
                << cinema[row].size() - 1 << "): ";
            cin >> seat;

            if (seat < 0 || seat >= cinema[row].size()) {
                cout << "Такого места нет!\n";
            }
            else if (cinema[row][seat]) {
                cout << "Это место уже занято!\n";
            }
            else {
                cinema[row][seat] = true;
                cout << "Место " << seat << " в ряду "
                    << row << " успешно забронировано!\n";
            }
        }

        else if (choice == 2) {
            int freeSeats = 0;

            for (int i = 0; i < cinema.size(); i++) {
                for (int j = 0; j < cinema[i].size(); j++) {
                    if (!cinema[i][j]) {
                        freeSeats++;
                    }
                }
            }

            cout << "Всего свободных мест в зале: "
                << freeSeats << endl;
        }

        else if (choice == 3) {
            int maxRow = 0;
            int maxOccupied = -1;

            for (int i = 0; i < cinema.size(); i++) {
                int occupied = 0;

                for (int j = 0; j < cinema[i].size(); j++) {
                    if (cinema[i][j]) {
                        occupied++;
                    }
                }

                if (occupied > maxOccupied) {
                    maxOccupied = occupied;
                    maxRow = i;
                }
            }

            cout << "Самый заполненный ряд: " << maxRow
                << " (занято " << maxOccupied
                << " из " << cinema[maxRow].size()
                << " мест)\n";
        }

        else if (choice == 4) {
            int row, seat;

            cout << "Введите номер ряда (0-9): ";
            cin >> row;

            if (row < 0 || row >= 10) {
                cout << "Такого ряда нет!\n";
                continue;
            }

            cout << "Введите номер места (0-"
                << cinema[row].size() - 1 << "): ";
            cin >> seat;

            if (seat < 0 || seat >= cinema[row].size()) {
                cout << "Такого места нет!\n";
            }
            else if (!cinema[row][seat]) {
                cout << "Это место уже свободно!\n";
            }
            else {
                cinema[row][seat] = false;
                cout << "Билет успешно возвращён!\n";
            }
        }

        else if (choice == 0) {
            cout << "Программа завершена.\n";
        }
        else {
            cout << "Неверный пункт меню!\n";
        }
    } while (choice != 0);
    return 0;
}
